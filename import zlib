def decompress_folder(folder_path, output_folder):
    if not os.path.exists(output_folder):
        os.makedirs(output_folder)
    for filename in os.listdir(folder_path):
        if filename.endswith('.compressed'):
            compressed_file_path = os.path.join(folder_path, filename)
            output_file_path = os.path.join(output_folder, os.path.splitext(filename)[0])  # Remove file extension
            if filename.endswith(('.jpg', '.jpeg', '.png', '.gif')):
                decompress_image(compressed_file_path, output_file_path)
            elif filename.endswith(('.mp3', '.wav', '.ogg')):
                decompress_audio(compressed_file_path, output_file_path)
            elif filename.endswith(('.mp4', '.avi', '.mov')):
                decompress_video(compressed_file_path, output_file_path)
            elif filename.endswith(('.txt', '.csv', '.doc', '.docx', '.xls', '.xlsx')):
                decompress_text(compressed_file_path, output_file_path)
            # Add conditions for other file types
            else:
                print(f"Unsupported file type: {filename}")

