import os
import subprocess

def decompress_image(compressed_file_path, output_path):
    try:
        subprocess.run(["convert", compressed_file_path, output_path])  # Using ImageMagick's 'convert' command
        print("Decompression successful.")
    except Exception as e:
        print("Error during decompression:", e)

def decompress_audio(compressed_file_path, output_path):
    try:
        subprocess.run(["ffmpeg", "-i", compressed_file_path, output_path])  # Using FFmpeg
        print("Decompression successful.")
    except Exception as e:
        print("Error during decompression:", e)

def decompress_video(compressed_file_path, output_path):
    try:
        subprocess.run(["ffmpeg", "-i", compressed_file_path, "-c:v", "copy", output_path])  # Using FFmpeg
        print("Decompression successful.")
    except Exception as e:
        print("Error during decompression:", e)

def decompress_text(compressed_file_path, output_path):
    try:
        with open(compressed_file_path, 'rb') as f:
            compressed_data = f.read()
        with open(output_path, 'wb') as f:
            f.write(compressed_data)  # Text files are usually uncompressed
        print("Decompression successful.")
    except Exception as e:
        print("Error during decompression:", e)

